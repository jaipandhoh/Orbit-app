# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# MySQL / PostgreSQL (legacy local DB)
DB_HOST=localhost
DB_USER=orbit_user
DB_PASSWORD=your_db_password_here
DB_NAME=orbit
DB_PORT=3306

# PostgreSQL via Supabase (used in production)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<host>:6543/postgres?pgbouncer=true

# Supabase auth — JWT Secret is found in:
# Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
# This is a SERVER-SIDE secret. Never prefix it with VITE_.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Supabase public keys (safe to expose to the browser, anon key is row-level-security protected)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
